# ==============================================================================
# AAVAaz Platform - Global Environment Configuration Template
# Copy this file to .env or configure respective frontend/.env and backend/.env
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend Server Configuration
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=aavaaz_dev
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Authentication & Security
# Generate using: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECRET=optional_cookie_signing_secret_at_least_32_chars

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000/api/v1
