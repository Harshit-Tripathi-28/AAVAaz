# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port and Host
PORT=4000
HOST=0.0.0.0

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# Database Connection URL (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aavaaz_dev?schema=public

# Authentication Secrets
# Secure random string of at least 32 characters (e.g., generated with `openssl rand -base64 32`)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_dev
JWT_EXPIRES_IN=7d
